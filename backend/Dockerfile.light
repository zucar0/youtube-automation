# Dockerfile.light — colócalo en backend/Dockerfile.light
# Usado por la rama ligera: no transcribe ni descarga video, así que no necesita ffmpeg.
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir --break-system-packages -r requirements.txt

COPY . .

CMD ["python", "-m", "bot.telegram_bot"]